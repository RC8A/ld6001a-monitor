# Allow-list: vendor programs, logs, local settings, binaries and old source stay local.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/COPYRIGHT
!/LICENSE.txt
!/CHANGELOG.md
!/RELEASE-NOTES.md
!/CONTRIBUTING.md
!/PUBLISHING.md
!/version.txt
!/Source/
/Source/*
!/Source/AppIdentity.cs
!/Source/Language.cs
!/Source/Protocol.cs
!/Source/Settings.cs
!/Source/Zones.cs
!/Source/ParameterModel.cs
!/Source/Trails.cs
!/Source/CoreTests.cs
!/Source/NumberField.cs
!/Source/RadarCanvas.cs
!/Source/WpfRows.cs
!/Source/WpfMonitor.cs
!/Source/WpfProgram.cs
!/Source/Main.xaml
!/Source/Build.ps1
!/Source/MakeBrand.ps1
!/Source/Assets/
/Source/Assets/*
!/Source/Assets/ld-monitor.ico
!/Source/Assets/ld-monitor-icon.svg
!/Source/Assets/ld-monitor-icon.png
!/Source/Assets/ld-monitor-logo.svg
!/Source/Assets/ld-monitor-logo.png
!/scripts/
/scripts/*
!/scripts/Bump-Version.ps1
!/scripts/Package-Release.ps1
!/scripts/Publish-Private.ps1
!/.github/
!/.github/**
