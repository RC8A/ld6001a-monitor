<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:RadarTest;assembly=LD6001A Monitor"
 Title="LD6001A Monitor" Width="1120" Height="780" MinWidth="960" MinHeight="650" FontFamily="Segoe UI" FontSize="12" Background="#F3F5F8" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
 <Window.Resources>
  <Style TargetType="Button">
   <Setter Property="Height" Value="28"/><Setter Property="MinWidth" Value="94"/><Setter Property="Margin" Value="0,0,4,0"/>
   <Setter Property="Background" Value="#FFFFFF"/><Setter Property="BorderBrush" Value="#ADB8C7"/><Setter Property="Foreground" Value="#182536"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="3">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" Margin="8,0"/>
    </Border><ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#3974A8"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.7"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.5"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBox"><Setter Property="Height" Value="28"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Padding" Value="6,0"/><Setter Property="Margin" Value="0,0,4,0"/><Setter Property="BorderBrush" Value="#ADB8C7"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Height" Value="28"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Padding" Value="5,0"/><Setter Property="Margin" Value="0,0,4,0"/></Style>
  <Style TargetType="CheckBox">
   <Setter Property="Height" Value="28"/><Setter Property="Margin" Value="0,0,12,0"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
    <Grid VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="16"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Border Width="14" Height="14" VerticalAlignment="Center" BorderBrush="#8998AB" Background="White" BorderThickness="1" CornerRadius="2">
      <TextBlock x:Name="Mark" Text="✓" Visibility="Collapsed" Foreground="#246A9C" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
     </Border><ContentPresenter Grid.Column="1" VerticalAlignment="Center" Margin="5,0,0,0"/>
    </Grid><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Mark" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="DataGrid"><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="CanUserDeleteRows" Value="False"/><Setter Property="CanUserResizeRows" Value="False"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="RowHeight" Value="24"/><Setter Property="ColumnHeaderHeight" Value="26"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="BorderBrush" Value="#B7C2D0"/><Setter Property="HorizontalGridLinesBrush" Value="#E3E8EE"/><Setter Property="Background" Value="White"/><Setter Property="FontSize" Value="11"/></Style>
  <Style x:Key="Caption" TargetType="TextBlock"><Setter Property="Height" Value="28"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="TextAlignment" Value="Left"/><Setter Property="Padding" Value="0,6,5,0"/></Style>
 </Window.Resources>
 <DockPanel LastChildFill="True">
  <Menu DockPanel.Dock="Top" Background="#F3F5F8" Padding="2,0" Height="23"><MenuItem Header="Настройки"><MenuItem x:Name="ParametersMenu" Header="Параметры DEBUG 0 / DEBUG 3…"/><MenuItem x:Name="ReadMenu" Header="Считать параметры из датчика"/></MenuItem><MenuItem Header="Справка"><MenuItem x:Name="AboutMenu" Header="О программе…"/></MenuItem><MenuItem Header="Язык / Language"><MenuItem x:Name="RussianMenu" Header="Русский" IsCheckable="True"/><MenuItem x:Name="EnglishMenu" Header="English" IsCheckable="True"/></MenuItem></Menu>
  <Border DockPanel.Dock="Top" Padding="5,2,1,3" BorderBrush="#CED7E2" BorderThickness="0,0,0,1">
   <StackPanel x:Name="Header">
    <WrapPanel x:Name="ConnectionRow" Margin="0,0,0,3" ItemHeight="28">
     <TextBlock Text="COM:" Style="{StaticResource Caption}"/><ComboBox x:Name="Ports" Width="80"/><ComboBox x:Name="Baud" Width="96"/>
     <Button x:Name="Refresh" Content="Обновить"/><Button x:Name="Connect" Content="Подключить" Width="110"/><Button x:Name="Demo" Content="Демо" MinWidth="68"/>
     <TextBlock Text="Радиус, см:" Style="{StaticResource Caption}" Margin="5,0,0,0"/><local:NumberField x:Name="RangeInput" Minimum="100" Maximum="500" Value="450" Width="66"/>
     <TextBlock Text="Высота, см:" Style="{StaticResource Caption}"/><local:NumberField x:Name="HeightInput" Minimum="50" Maximum="500" Value="300" Width="66"/>
     <TextBlock Text="Порог:" Style="{StaticResource Caption}"/><local:NumberField x:Name="ThresholdInput" Minimum="1" Maximum="9" Value="4" Width="50"/>
    </WrapPanel>
    <WrapPanel x:Name="CommandsRow" Margin="0,0,0,3" ItemHeight="28">
     <Button x:Name="Read" Content="AT+READ"/><Button x:Name="Start" Content="AT+START"/><Button x:Name="Stop" Content="AT+STOP"/>
     <Button x:Name="Debug0" Content="AT+DEBUG=0"/><Button x:Name="Debug3" Content="AT+DEBUG=3"/>
     <TextBox x:Name="CustomCommand" Text="AT+READ" Width="130"/><Button x:Name="Send" Content="Отправить + LF" MinWidth="118"/>
    </WrapPanel>
    <WrapPanel x:Name="ViewRow" ItemHeight="28">
     <CheckBox x:Name="Phosphor" Content="Люминофор" IsChecked="True"/>
     <TextBlock Text="Затухание, с:" Style="{StaticResource Caption}"/><local:NumberField x:Name="Fade" Minimum="0.5" Maximum="60" DecimalPlaces="1" Step="0.5" Value="10" Width="66"/>
     <CheckBox x:Name="MirrorX" Content="Зеркало X"/><CheckBox x:Name="MirrorY" Content="Зеркало Y"/>
     <CheckBox x:Name="HideStream" Content="Скрыть поток данных" IsChecked="True"/>
    </WrapPanel>
   </StackPanel>
  </Border>
  <TextBlock DockPanel.Dock="Top" x:Name="CommandStatus" Text="При подключении параметры считываются из датчика." Padding="6,3" Foreground="#4A596C" TextTrimming="CharacterEllipsis"/>
  <TextBlock DockPanel.Dock="Bottom" x:Name="Status" Text="Отключено · UART 8N1" Padding="6,4" Background="#E8EDF4" TextTrimming="CharacterEllipsis"/>
  <Grid x:Name="WorkArea">
   <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition x:Name="LogRow" Height="0"/></Grid.RowDefinitions>
   <Grid x:Name="MapHost" Background="#141C28" ClipToBounds="True">
    <TextBlock x:Name="Axes" Text="X →   Y ↑   шаг сетки: 1" Foreground="#E5EEF7" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="3,2,0,0" IsHitTestVisible="False"/>
    <DataGrid x:Name="Targets" IsReadOnly="True" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="2,24,0,0" Width="415" MaxHeight="300" CanUserSortColumns="False" CanUserResizeColumns="False" CanUserReorderColumns="False" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
     <DataGrid.Columns><DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="34"/><DataGridTextColumn Header="X" Binding="{Binding X, StringFormat=F3}" Width="*"/><DataGridTextColumn Header="Y" Binding="{Binding Y, StringFormat=F3}" Width="*"/><DataGridTextColumn Header="Z" Binding="{Binding Z, StringFormat=F3}" Width="*"/><DataGridTextColumn Header="Vx" Binding="{Binding Vx, StringFormat=F3}" Width="*"/><DataGridTextColumn Header="Vy" Binding="{Binding Vy, StringFormat=F3}" Width="*"/><DataGridTextColumn Header="Vz" Binding="{Binding Vz, StringFormat=F3}" Width="*"/></DataGrid.Columns>
    </DataGrid>
    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,2,0" Width="366" Padding="4" Background="#F3F5F8" BorderBrush="#AFBAC9" BorderThickness="1">
     <StackPanel><TextBlock Text="Зона обнаружения · см" FontWeight="SemiBold" Margin="0,0,0,4"/>
      <DataGrid x:Name="Zones" Height="78" CanUserSortColumns="False" CanUserReorderColumns="False" CanUserResizeColumns="False" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" SelectionUnit="Cell">
       <DataGrid.Resources>
        <Style TargetType="DataGridColumnHeader"><Setter Property="Height" Value="26"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Padding" Value="2,0"/><Setter Property="Background" Value="#E8EDF4"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
        <Style x:Key="ZoneCellText" TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="TextAlignment" Value="Right"/><Setter Property="Margin" Value="3,0,7,0"/></Style>
        <Style x:Key="ZoneCellEditor" TargetType="TextBox"><Setter Property="Height" Value="23"/><Setter Property="Margin" Value="0"/><Setter Property="Padding" Value="2,0,6,0"/><Setter Property="TextAlignment" Value="Right"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
        <Style TargetType="DataGridRow"><Style.Triggers><DataTrigger Binding="{Binding IsSensor}" Value="True"><Setter Property="Background" Value="#EDF4F0"/><Setter Property="Foreground" Value="#355348"/></DataTrigger></Style.Triggers></Style>
       </DataGrid.Resources>
       <DataGrid.Columns><DataGridTextColumn Header="Зона" Binding="{Binding Name}" IsReadOnly="True" Width="74"/><DataGridTextColumn Header="X−" Binding="{Binding XMin}" Width="*" ElementStyle="{StaticResource ZoneCellText}" EditingElementStyle="{StaticResource ZoneCellEditor}"/><DataGridTextColumn Header="X+" Binding="{Binding XMax}" Width="*" ElementStyle="{StaticResource ZoneCellText}" EditingElementStyle="{StaticResource ZoneCellEditor}"/><DataGridTextColumn Header="Y−" Binding="{Binding YMin}" Width="*" ElementStyle="{StaticResource ZoneCellText}" EditingElementStyle="{StaticResource ZoneCellEditor}"/><DataGridTextColumn Header="Y+" Binding="{Binding YMax}" Width="*" ElementStyle="{StaticResource ZoneCellText}" EditingElementStyle="{StaticResource ZoneCellEditor}"/></DataGrid.Columns>
      </DataGrid>
      <StackPanel Orientation="Horizontal" Margin="0,4,0,0"><CheckBox x:Name="EditZone" Content="Мышью" Margin="0,0,10,0"/><Button x:Name="ReadZone" Content="Считать" MinWidth="80"/><TextBlock Text="Авто: через 1 с" Style="{StaticResource Caption}"/></StackPanel>
      <TextBlock x:Name="ZoneInfo" Text="Границы не считаны. Проект сохранён локально." FontSize="10" TextWrapping="Wrap" Margin="0,3,0,0"/>
     </StackPanel>
    </Border>
   </Grid>
   <TextBox x:Name="Log" Grid.Row="1" Height="Auto" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11" Margin="0"/>
  </Grid>
 </DockPanel>
</Window>
